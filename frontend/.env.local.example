# Environment Variables — copy to .env and fill in real values.
# This file is committed to version control as a template.

# ── App ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_ops
POSTGRES_USER=legal_ops_user
POSTGRES_PASSWORD=change-me-in-production

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── MinIO ────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contracts
MINIO_SECURE=false

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Limits ───────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=5

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
